# MongoDB connection string.
# Local dev:        mongodb://127.0.0.1:27017/lead-capture
# MongoDB Atlas:     mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lead-capture
MONGODB_URI=mongodb://localhost:27017/

# Port the server listens on (most hosts override this automatically)
PORT=3000

# Basic auth for /admin and the admin API endpoints (GET/PATCH /api/leads).
# Set these in production — if left blank, /admin is unprotected.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
